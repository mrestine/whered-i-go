{
  "name": "whered-i-go",
  "version": "0.1.0",
  "description": "Reverse geocode GPX/FIT rides to list geographic areas crossed",
  "homepage": "https://mrestine.github.io/whered-i-go",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production && cp -r public/assets dist/ && cp public/favicon.svg dist/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.24.0",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.8.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vercel": "^50.33.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "fit-file-parser-typescript": "^1.20.1",
    "gpxparser": "^3.0.8",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  }
}
